{% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
    <div class="user-management-container">
        <h1 class="user-management-title">User Management</h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-back">Retour au Dashboard</a>

        <table class="user-table">
            <thead>
            <tr class="user-table-header">
                <th>Email</th>
                <th>Team</th>
                <th>Utilisateur vérifié</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr class="user-table-row">
                    <td class="user-table-data">{{ user.email }}</td>
                    <td class="user-table-data">{{ user.selectedTeam ? user.selectedTeam.name : 'Aucune équipe sélectionnée' }}</td>
                    <td class="user-table-data">
                        {{ user.isVerified ? 'Vérifié' : 'Non vérifié' }}
                    </td>
                    <td class="user-table-actions">
                        <a href="{{ path('admin_edit_user', {'id': user.id}) }}" class="btn btn-edit">Edit</a>
                        <a href="{{ path('admin_delete_user', {'id': user.id}) }}" class="btn btn-delete">Delete</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('admin_add_user') }}" class="btn btn-add-user">Add User</a>
    </div>
{% endblock %}